<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Coffee Rush</title>
<link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;700;900&display=swap" rel="stylesheet">
<style>
:root{box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);
--bg:#f6ead8;--card:#fff8ec;--ink:#3b2314;--muted:#8a6a52;--accent:#d2691e;--line:#e5d2b8}
:root:not([data-theme="light"]){}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#1d130d;--card:#2a1c13;--ink:#f6e6d0;--muted:#b99677;--accent:#f0944d;--line:#43301f}}
:root[data-theme="dark"]{--bg:#1d130d;--card:#2a1c13;--ink:#f6e6d0;--muted:#b99677;--accent:#f0944d;--line:#43301f}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{height:100%;margin:0}
body{background:var(--bg);color:var(--ink);font-family:'Vazirmatn',Tahoma,sans-serif;display:flex;flex-direction:column;align-items:center;user-select:none;-webkit-user-select:none;touch-action:manipulation;overflow:hidden}
h1{margin:10px 0 2px;font-size:26px;font-weight:900;letter-spacing:.5px}
h1 span{color:var(--accent)}
.stats{display:flex;gap:8px;width:min(420px,94%);margin:6px 0}
.stat{flex:1;background:var(--card);border:1px solid var(--line);border-radius:14px;padding:6px 4px;text-align:center}
.stat small{display:block;color:var(--muted);font-size:11px}
.stat b{font-size:22px;font-weight:900}
#time.low{color:#d23b2a}
.stage{position:relative;flex:1;min-height:0;width:min(420px,100%);display:flex;align-items:center;justify-content:center}
svg{height:100%;max-height:100%;width:auto;max-width:100%}
#cupg{cursor:pointer;transform-box:fill-box;transform-origin:50% 100%}
#cupg.pop{animation:pop .14s ease-out}
@keyframes pop{0%{transform:scale(1)}40%{transform:scale(.93,1.06)}100%{transform:scale(1)}}
.steam path{fill:none;stroke:var(--muted);stroke-width:4;stroke-linecap:round;opacity:0}
.go .steam path{animation:st 2s infinite}
.steam path:nth-child(2){animation-delay:.6s}.steam path:nth-child(3){animation-delay:1.2s}
@keyframes st{0%{opacity:0;transform:translateY(8px)}40%{opacity:.6}100%{opacity:0;transform:translateY(-14px)}}
.stream{opacity:0}
.go .stream{opacity:1;animation:fl .25s linear infinite}
@keyframes fl{to{stroke-dashoffset:-12}}
.led{opacity:.35}.go .led{opacity:1}
#ov{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;overflow-y:auto;gap:8px;background:color-mix(in srgb,var(--bg) 82%,transparent);text-align:center;padding:20px;backdrop-filter:blur(3px);z-index:2}
#ov.hide{display:none}
#ov h2{margin:0;font-size:24px;font-weight:900}
#ov p{margin:0;color:var(--muted);font-size:14px;line-height:1.8}
#ov .big{font-size:56px;font-weight:900;color:var(--accent);line-height:1}
button{font-family:inherit;font-size:20px;font-weight:900;color:#fff;background:var(--accent);border:0;border-radius:16px;padding:12px 34px;margin-top:6px;box-shadow:0 5px 0 rgba(0,0,0,.25);cursor:pointer}
button:active{transform:translateY(3px);box-shadow:0 2px 0 rgba(0,0,0,.25)}
.hint{color:var(--muted);font-size:13px;margin:4px 0 10px;min-height:20px}
#ov::before,#ov::after{content:'';margin:auto}
#shop{width:100%;display:flex;flex-direction:column;gap:6px;margin-top:6px}
.coins{font-size:18px;font-weight:900}
.up{display:flex;align-items:center;gap:8px;background:var(--card);border:1px solid var(--line);border-radius:14px;padding:8px 10px;text-align:right}
.ui{font-size:24px}
.ut{flex:1}.ut b{font-size:14px}
.ut small{display:block;color:var(--muted);font-size:11px;line-height:1.6}
#ovT:empty{display:none}
.chest{display:inline-block;color:var(--accent);font-weight:900;animation:chest .6s ease-out}
@keyframes chest{0%{transform:scale(.3);opacity:0}60%{transform:scale(1.25)}100%{transform:scale(1);opacity:1}}
#cm{position:fixed;inset:0;z-index:10;display:none;align-items:center;justify-content:center;background:rgba(0,0,0,.6)}
#cm.show{display:flex}
.cw.big{transform:scale(1.7)}
.cw.big .cr{color:#ffd23f;font-size:18px}
.gc{width:48px;flex:none;opacity:.65}
.gc .csvg{width:48px;height:auto;max-width:none;max-height:none;display:block;overflow:visible}
.gc.rdy{opacity:1;cursor:pointer}
.gc.rdy .csvg{animation:shk 1.1s ease-in-out infinite}
.gc:not(.rdy) .glow{opacity:0;animation:none}
.gc.rdy .glow{opacity:.8;animation:glw 1.1s ease-in-out infinite}
@keyframes shk{0%,100%{transform:translateX(0) rotate(0)}15%{transform:translateX(-3px) rotate(-9deg)}30%{transform:translateX(3px) rotate(9deg)}45%{transform:translateX(-2px) rotate(-6deg)}60%{transform:translateX(2px) rotate(5deg)}75%{transform:translateX(0) rotate(0)}}
.bar i.full{background:linear-gradient(90deg,#ffd23f,#ff9f1c)}
#chests{display:flex;gap:10px;justify-content:center;flex-wrap:wrap}
.cw{position:relative;width:120px;text-align:center;cursor:pointer;user-select:none}
.csvg{width:120px;height:auto;max-width:none;max-height:none;display:block;overflow:visible}
.csvg .lidc{transform-origin:60px 58px;transition:transform .3s ease,opacity .2s}
.csvg .lido{transform-origin:60px 58px;transform:scaleY(.1);opacity:0;transition:transform .45s cubic-bezier(.3,1.6,.5,1) .12s,opacity .2s .12s}
.csvg .inside{opacity:0;transition:opacity .3s}
.csvg .glow{opacity:.35;animation:glw 1.4s ease-in-out infinite}
.cw.op .lidc{transform:translateY(-10px) scaleY(.15);opacity:0}
.cw.op .lido{transform:scaleY(1);opacity:1}
.cw.op .inside{opacity:1}
.cw.op .glow{opacity:1;animation:none}
.cw:not(.op) .csvg{animation:wob 1.3s ease-in-out infinite}
@keyframes wob{0%,100%{transform:rotate(0)}20%{transform:rotate(-4deg)}40%{transform:rotate(4deg)}60%{transform:rotate(-2deg)}}
@keyframes glw{50%{opacity:.7}}
.cr{font-weight:900;color:var(--accent);min-height:24px;font-size:15px}
.cw.op .cr{animation:chest .6s ease-out}
.rinfo{text-align:center;font-size:13px;color:var(--muted);line-height:1.8}.rinfo b{color:var(--accent)}
.bar{height:6px;background:var(--line);border-radius:3px;margin-top:5px;overflow:hidden}
.bar i{display:block;height:100%;width:0;background:var(--accent);border-radius:3px}
.buy{font-size:13px;padding:8px 10px;margin:0;border-radius:12px;box-shadow:0 3px 0 rgba(0,0,0,.25);white-space:nowrap}
button:disabled{opacity:.5;pointer-events:none}
#mute{position:absolute;top:calc(env(safe-area-inset-top,0px) + 10px);left:12px;font-size:20px;padding:6px 10px;margin:0;border-radius:12px;background:var(--card);color:var(--ink);border:1px solid var(--line);box-shadow:none}
.toast{position:absolute;left:50%;top:34%;transform:translateX(-50%);white-space:nowrap;font-weight:900;font-size:24px;color:var(--accent);background:var(--card);border:2px solid var(--accent);border-radius:16px;padding:6px 16px;pointer-events:none;animation:toast 1s forwards;z-index:1}
@keyframes toast{0%{opacity:0;transform:translateX(-50%) scale(.6)}20%{opacity:1;transform:translateX(-50%) scale(1.1)}80%{opacity:1}100%{opacity:0;transform:translateX(-50%) translateY(-40px)}}
#cupg.done{animation:done .45s ease-out}
@keyframes done{0%{transform:scale(1)}30%{transform:scale(1.12,.92)}60%{transform:scale(.95,1.08)}100%{transform:scale(1)}}
.spark{position:absolute;font-size:18px;pointer-events:none;animation:sp .8s forwards}
@keyframes sp{to{transform:translate(var(--dx),var(--dy)) scale(.4);opacity:0}}
.plus{position:absolute;font-weight:900;color:var(--accent);pointer-events:none;animation:up .6s forwards;font-size:22px}
@keyframes up{to{transform:translateY(-50px);opacity:0}}
#bg{position:fixed;inset:0;z-index:-1;pointer-events:none}
#bg{overflow:hidden}
#bgsvg{width:100%;height:100%;max-width:none;max-height:none;display:block}
#vg{position:fixed;inset:0;z-index:-1;pointer-events:none;background:radial-gradient(ellipse at 50% 40%,rgba(255,244,220,.22),rgba(255,244,220,0) 52%),radial-gradient(ellipse at 50% 45%,rgba(0,0,0,0) 45%,rgba(0,0,0,.26) 100%)}
#svg{overflow:visible;max-width:80%}
h1,.hint{background:var(--card);padding:2px 16px;border-radius:14px;opacity:.95}
</style>
</head>
