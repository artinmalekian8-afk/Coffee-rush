];
const GOALS=[{c:80,r:450},{c:250,r:500},{c:500,r:600},{c:800,r:700},{c:1400,r:2500},{c:2400,r:2900},{c:3600,r:3300},{c:5000,r:3800},{c:7000,r:11000},{c:9500,r:12500},{c:12500,r:14500},{c:16000,r:17000},{c:21000,r:51000},{c:28000,r:59000},{c:36000,r:68000},{c:45000,r:79000},{c:58000,r:240000},{c:75000,r:280000},{c:95000,r:330000},{c:120000,r:390000},{c:150000,r:460000}];
const BODY=[['#8e2a1f','#d4503a','#b53a28','#7a2217'],['#1f6b3a','#3fae6a','#2f8f55','#175330'],['#2b6f9e','#6cc4f0','#4aa6d8','#1f5880'],['#b8860b','#ffd23f','#e0aa1c','#946a08'],['#161616','#5a5a5a','#2e2e2e','#0a0a0a']];
const CUPS=[{c:['#d9d3ca','#fff','#c4bdb2'],b:null},{c:['#cfe8d6','#f4fff7','#a9cdb4'],b:'#2f8f55'},{c:['#c5e3f5','#f2fbff','#9dc8e2'],b:'#4aa6d8'},{c:['#f3e3a6','#fff8d8','#d9c071'],b:'#e0aa1c'},{c:['#3a3a3a','#808080','#1c1c1c'],b:'#d4af37'}],CUPG=['#b8860b','#ffe27a','#a8740a'];
