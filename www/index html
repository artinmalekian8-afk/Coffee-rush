  const r=$('svg').getBoundingClientRect(),s=st.getBoundingClientRect();
  const cx=r.left-s.left+r.width/2,cy=r.top-s.top+r.height*0.72;
  for(let i=0;i<8;i++){const a=i/8*6.283,p=document.createElement('div');p.className='spark';p.textContent=i%2?'✨':'⭐';p.style.left=cx+'px';p.style.top=cy+'px';p.style.setProperty('--dx',Math.cos(a)*70+'px');p.style.setProperty('--dy',Math.sin(a)*70-20+'px');st.appendChild(p);setTimeout(()=>p.remove(),800)}
  const c=$('cupg');c.classList.remove('pop','done');void c.getBoundingClientRect();c.classList.add('done');
  setTimeout(()=>setFill(),280);
}
function start(){
  audio();pendSum=0;$('chests').innerHTML='';gold=(rounds+1)%10===0;paint();taps=0;cups=0;cupTaps=0;$('cups').textContent=fa(0);playing=true;endAt=performance.now()+DUR;
  $('taps').textContent=fa(0);$('time').classList.remove('low');
  $('ov').classList.add('hide');$('svg').classList.add('go');
  $('hint').textContent='تند تند تپ کن! 🔥';
  setFill();cancelAnimationFrame(raf);tick();
}
function tick(){
  const left=Math.max(0,endAt-performance.now());
  $('time').textContent=fa(left/1000,1);
  $('time').classList.toggle('low',left<5000);
  if(left<=0){end();return}
  raf=requestAnimationFrame(tick);
}
function end(){
  playing=false;$('svg').classList.remove('go');
  const isNew=taps>best&&taps>0;
  if(isNew){best=taps;try{localStorage.setItem(KEY,String(best))}catch(e){}}
  $('best').textContent=fa(best);$('time').textContent=fa(0,1);
  $('ovTop').style.display='block';$('ovTop').textContent=fa(taps);
  $('ovT').textContent=isNew?'🏆 رکورد جدید!':'تمام شد!';
  const tps=fa(taps/(DUR/1000),1);
  const mult=gold?2:1,wasGold=gold;gold=false;paint();
  const earn=cups*CP[cL]*mult;coins+=earn;rounds++;
  totC+=cups;let tb=0,tm='';const ch=[];
  coins+=tb;save();renderShop();
  $('ovP').innerHTML='قهوه سرو شده: <b>'+fa(cups)+'</b> × '+fa(CP[cL])+(wasGold?' × ۲ 🌟':'')+' 🪙 = <b>+'+fa(earn)+' 🪙</b><br>'+'سرعت تو: <b>'+tps+'</b> تپ در ثانیه<br>'+(isNew?'بهترین رکوردت رو شکستی!':'بهترین رکورد: <b>'+fa(best)+'</b> تپ');
  const b=$('startBtn');b.textContent='دوباره';b.disabled=true;setTimeout(()=>{b.disabled=false},1200);
  $('ovP').innerHTML+=tm;isNew?sndRecord():sndEnd();
  $('ov').classList.remove('hide');
  $('hint').textContent='برای رکورد بیشتر دوباره بازی کن';
}
function hit(e){
  if(!playing)return;
  e.preventDefault();
  taps++;cupTaps+=1/need();$('taps').textContent=fa(taps);
  const done=cupTaps>=1-1e-9;
  if(done){cups++;cupTaps=Math.max(0,cupTaps-1);$('cups').textContent=fa(cups)}
  setFill(done&&need()>3);
  const c=$('cupg');c.classList.remove('pop','done');void c.getBoundingClientRect();c.classList.add('pop');
  const st=$('stage').getBoundingClientRect();
  const p=document.createElement('div');p.className='plus';p.textContent='+۱';
  p.style.left=(e.clientX-st.left-10)+'px';p.style.top=(e.clientY-st.top-20)+'px';
  $('stage').appendChild(p);setTimeout(()=>p.remove(),600);
  if(navigator.vibrate)try{navigator.vibrate(8)}catch(_){}
  if(done)served();else sndTap(Math.round(cupTaps*9));
}
$('mute').textContent=muted?'🔇':'🔊';
$('mute').addEventListener('click',()=>{audio();muted=!muted;$('mute').textContent=muted?'🔇':'🔊';try{localStorage.setItem('coffeerush_mute',muted?'1':'0')}catch(e){}});
$('cupg').addEventListener('pointerdown',hit);
$('startBtn').addEventListener('click',start);
$('mBuy').addEventListener('click',()=>{if(mL<NL-1&&coins>=MC[mL]){coins-=MC[mL];mL++;save();renderShop();audio();sndServe()}});
$('cBuy').addEventListener('click',()=>{if(cL<NL-1&&coins>=CC[cL]){coins-=CC[cL];cL++;save();renderShop();audio();sndServe()}});
$('cfBuy').addEventListener('click',()=>{
  if(cafe>=CF.length-1||coins<CF[cafe+1].p)return;
  if(!cfArmed){cfArmed=true;renderShop();setTimeout(()=>{cfArmed=false;renderShop()},3000);return}
  cfArmed=false;coins-=CF[cafe+1].p;cafe++;mL=0;cL=0;cupTaps=0;applyCafe();paint();save();renderShop();audio();sndRecord();setFill();
});
$('gChest').addEventListener('pointerdown',claim);
$('cm').addEventListener('pointerdown',()=>{if($('cm').dataset.ok==='1')$('cm').classList.remove('show')});
paint();renderShop();
setFill();
</script>
</body>
